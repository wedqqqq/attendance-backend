# ─── Database ───────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/attendance?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_64_chars_minimum
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_secret_here_64_chars_minimum
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins
ALLOWED_ORIGINS=http://localhost:3001,https://your-admin.pages.dev

# ─── QR ──────────────────────────────────────────────────────────────────────
# Secret for HMAC QR signing (32+ chars)
QR_SIGNING_SECRET=your_qr_signing_secret_here

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
ATTENDANCE_RATE_LIMIT_MAX=10

# ─── Geofence ────────────────────────────────────────────────────────────────
# Meters
CHECKIN_RADIUS_METERS=50
ACTIVE_ZONE_RADIUS_METERS=400
VIOLATION_GRACE_PERIOD_MINUTES=5
GPS_ACCURACY_THRESHOLD_METERS=50
